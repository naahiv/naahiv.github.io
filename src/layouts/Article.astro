---
import Site from './Site.astro';
import 'katex/dist/katex.min.css';
import { dateLabel, tagSlug } from '../lib/posts';
const {post, allPosts=[]} = Astro.props;
const toc = post.headings?.filter(h=>h.depth===2) || [];
const series = post.series ? allPosts.filter(p=>p.series?.name===post.series.name).sort((a,b)=>a.series.order-b.series.order) : [];
const index = series.findIndex(p=>p.slug===post.slug);
const related = allPosts.filter(p=>p.slug!==post.slug).slice(0,2);
---
<Site title={post.title} description={post.summary} active="blog" article draft={post.draft}>
  <div id="top" class="article-shell shell">
    <div class="article-topline"><a href="/blog/">← All writing</a><span>{post.specimen ? 'Development specimen' : post.draft ? 'Draft preview' : 'Mathematics blog'}</span></div>
    <header class="article-header">
      {post.draft && <p class="draft-label">{post.specimen ? 'Preview · unpublished specimen' : 'Preview · unpublished draft'}</p>}
      <div class="post-meta"><time datetime={post.date}>{dateLabel(post.date)}</time><span aria-hidden="true">/</span><span>{Math.max(1, Math.ceil((post.searchText?.split(/\s+/).length || 500)/190))} min read</span></div>
      <h1 set:html={post.titleHtml || post.title} />
      <p class="article-deck">{post.summary}</p>
      <div class="article-tags">{post.tags.map(tag=><a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a>)}</div>
      {post.updated && <p class="updated">Updated <time datetime={post.updated}>{dateLabel(post.updated)}</time></p>}
    </header>
    <div class:list={['reading-layout',{'has-toc':toc.length>=3}]}>
      {toc.length>=3 && <aside class="contents" aria-label="Article contents"><details open><summary>On this page</summary><ol>{toc.map(h=><li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol></details></aside>}
      <article class="prose" aria-label={post.title} set:html={post.html} />
    </div>
    <div class="article-end">
      <p class="end-mark" aria-hidden="true">∎</p>
      {post.specimen && <p class="specimen-note">This article is a development specimen for the reading and authoring system. It is excluded from the published site.</p>}
      {series.length>1 && <nav class="series-nav" aria-label="Series navigation"><p>{post.series.name}</p><div>{series[index-1] && <a href={series[index-1].url}>← {series[index-1].title}</a>}{series[index+1] && <a href={series[index+1].url}>{series[index+1].title} →</a>}</div></nav>}
      {related.length>0 && <section class="related"><p class="eyebrow">Continue reading</p>{related.map(p=><a href={p.url}>{p.title}<span>→</span></a>)}</section>}
      <a class="text-link" href="/blog/">Back to the blog →</a>
    </div>
  </div>
</Site>

<script>import "../scripts/reading";</script>
