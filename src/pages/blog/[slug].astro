---
import Article from '../../layouts/Article.astro';
import {posts} from '../../lib/posts';
export async function getStaticPaths(){ const allPosts=await posts(); return allPosts.map(post=>({params:{slug:post.slug},props:{post,allPosts}})); }
const {post,allPosts}=Astro.props;
---
<Article post={post} allPosts={allPosts} />
