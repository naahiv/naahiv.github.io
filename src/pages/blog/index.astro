---
import Site from '../../layouts/Site.astro';
import PostList from '../../components/PostList.astro';
import {posts,tagSlug} from '../../lib/posts';
const all=await posts();
const tags=[...new Set(all.flatMap(p=>p.tags))].sort();
const preview=all.some(p=>p.draft);
---
<Site title="Blog" active="blog" description="Short and medium mathematical writing by Vihaan Dheer: ideas, examples, and proofs in algebraic geometry and beyond."><div class="shell" id="top"><header class="page-intro"><p class="eyebrow">Mathematical writing</p><h1>Notes in the margin.</h1><p class="lead">A place for an example, a proof, or an idea worth working through.</p>{preview&&<p class="draft-label">Development preview · includes unpublished drafts</p>}</header><div class="index-layout"><div>
{all.length>0?<><form class="blog-search" role="search" data-blog-search hidden><label class="search-field"><input type="search" aria-label="Search blog posts" placeholder="Search titles, topics, and prose" /></label><p class="results-summary" data-search-summary aria-live="polite">{all.length} posts</p></form><PostList posts={all}/><p class="work-empty" data-search-empty hidden>No matching posts. Try another word or topic.</p></>:<section class="empty-state"><div class="empty-symbol" aria-hidden="true">∅</div><h2>No posts just yet.</h2><p>When there’s a new piece of mathematical writing, it will appear here. In the meantime, the longer papers and notes are ready to read.</p><a class="text-link" href="/papers/">Explore papers &amp; notes →</a></section>}
</div><aside class="index-aside" aria-label="Browse the blog"><h2>Topics</h2>{tags.length?<ul>{tags.map(tag=><li><a href={`/blog/tags/${tagSlug(tag)}/`}>{tag.replaceAll('-',' ')}<span class="tag-count">{all.filter(p=>p.tags.includes(tag)).length}</span></a></li>)}</ul>:<p class="quiet">Topics will appear with the first posts.</p>}<h2>Keep reading</h2><ul><li><a href="/blog/archive/">Archive →</a></li><li><a href="/rss.xml">RSS feed ↗︎</a></li><li><a href="/papers/">Papers &amp; notes →</a></li></ul><p class="quiet">No account needed.<br/>New writing, at its own pace.</p></aside></div></div></Site>
<script>
const form=document.querySelector<HTMLFormElement>('[data-blog-search]');
if(form){form.hidden=false;const input=form.querySelector<HTMLInputElement>('input')!;let entries:any[]=[];let ready=false;form.addEventListener('submit',e=>e.preventDefault());const update=()=>{if(!ready)return;const q=input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);const matched=new Set(entries.filter(p=>q.every(term=>`${p.title} ${p.summary} ${p.tags.join(' ')} ${p.text}`.toLowerCase().includes(term))).map(p=>p.slug));for(const card of document.querySelectorAll<HTMLElement>('[data-post-entry]'))card.hidden=!matched.has(card.dataset.slug);form.querySelector<HTMLElement>('[data-search-summary]')!.textContent=`${matched.size} ${matched.size===1?'post':'posts'}`;document.querySelector<HTMLElement>('[data-search-empty]')!.hidden=matched.size>0;};input.addEventListener('input',update);fetch('/search.json').then(r=>{if(!r.ok)throw new Error('Search unavailable');return r.json();}).then(data=>{entries=data;ready=true;update();}).catch(()=>{form.querySelector<HTMLElement>('[data-search-summary]')!.textContent='Search is unavailable. All posts are listed below.';input.disabled=true;});}
</script>
