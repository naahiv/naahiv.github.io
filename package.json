{
  "name": "vihaan-dheer-mathematics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/prepare.mjs && astro dev --host 0.0.0.0",
    "build": "node scripts/prepare.mjs && astro build",
    "build:preview": "node scripts/build-preview.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run build && node scripts/verify-preservation.mjs",
    "new:post": "node scripts/new-post.mjs",
    "test:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@xmldom/xmldom": "0.9.12",
    "astro": "7.4.0",
    "gray-matter": "4.0.3",
    "js-yaml": "5.5.0",
    "katex": "0.19.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@mathjax/src": "4.1.3",
    "@playwright/test": "1.62.1"
  }
}
